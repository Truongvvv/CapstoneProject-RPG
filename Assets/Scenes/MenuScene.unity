      m_Calls: []
  m_text: "Objective (M\u1EE5c ti\xEAu):\n\tThu th\u1EADp 4 vi\xEAn Crystal of Balance
    \u0111\u1EC3 phong \u1EA5n Shadowfall\n\t\u0110\xE1nh b\u1EA1i c\xE1c boss: Bloodfang
    Dragon v\xE0 Seraphel\n\tHo\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 ch\xEDnh v\xE0 ph\u1EE5
    \u0111\u1EC3 tr\u1EDF th\xE0nh chi\u1EBFn binh m\u1EA1nh nh\u1EA5t\n\nControls
    (\u0110i\u1EC1u khi\u1EC3n):\n\tWASD: Di chuy\u1EC3n\n\tMouse: Xoay camera\n\tLeft
    Click: T\u1EA5n c\xF4ng th\u01B0\u1EDDng (Combo 3 \u0111\xF2n)\n\tRight Click:
    B\u1EAFn \u0111\u1EA1n ph\xE9p thu\u1EADt\n\tSpace: N\xE9 tr\xE1nh/L\u0103n\n\tQ:
    K\u1EF9 n\u0103ng \u0111\u1EB7c bi\u1EC7t (Cooldown 40s)\n\tE: T\u01B0\u01A1ng
    t\xE1c v\u1EDBi NPC/V\u1EADt ph\u1EA9m\n\tTab: M\u1EDF Quest Log\n\tESC: Menu/Pause\n\nBasic
    Rules (Lu\u1EADt c\u01A1 b\u1EA3n):\n\tM\xE1u v\u1EC1 0 \u2192 H\u1ED3i sinh
    t\u1EA1i Shrine g\u1EA7n nh\u1EA5t\n\tHo\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 \u0111\u1EC3
    nh\u1EADn EXP v\xE0 th\u0103ng c\u1EA5p\n\tM\u1ED7i c\u1EA5p \u0111\u1ED9 t\u0103ng
    120 HP v\xE0 m\u1EDF kh\xF3a s\u1EE9c m\u1EA1nh m\u1EDBi"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
