  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "How to earn EXP (C\xE1ch nh\u1EADn kinh nghi\u1EC7m):\n\tTi\xEAu di\u1EC7t
    Chomper: +70 EXP\n\tTi\xEAu di\u1EC7t Crooked/BlackMon: +200 EXP (quest)\n\tTi\xEAu
    di\u1EC7t Rhino: +250 EXP (quest)\n\tTi\xEAu di\u1EC7t Dragon: +500-1200 EXP\n\t\u0110\xE1nh
    b\u1EA1i Bloodfang Dragon: +2000 EXP\n\t\u0110\xE1nh b\u1EA1i Seraphel: +2500
    EXP\n\nLevel Up:\n\tM\u1ED7i level t\u0103ng 120 HP t\u1ED1i \u0111a\n\tEXP c\u1EA7n
    thi\u1EBFt cho level m\u1EDBi = EXP hi\u1EC7n t\u1EA1i \xD7 130%"
